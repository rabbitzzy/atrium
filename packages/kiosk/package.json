{
  "name": "@atrium/kiosk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
