{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    // The api/ functions are Node, not DOM, and use ESM .js import specifiers
    // that Vercel's build resolves. Bundler resolution covers both here.
    "types": ["node"]
  },
  "include": ["src", "api"]
}
