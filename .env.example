# Copy to .env and fill in values. Never commit .env.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Gemini is the active provider for generation, worksheet evaluation, and OCR.
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash

# Claude is the longer-term option; ../chess-karma still uses it directly.
ANTHROPIC_API_KEY=sk-ant-...

# ── Illustration generation (tools/illustrate.ts) ────────────────────────────
# Provider is chosen automatically: FAL_KEY wins over HF_TOKEN if both are set.
# Override with: PROVIDER=hf or PROVIDER=fal
HF_TOKEN=hf_...
FAL_KEY=...

# ── Supabase ─────────────────────────────────────────────────────────────────
# Atrium's own project: owns captures + the flywheel tables.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# BHCS portal — read-only source of truth for the student roster.
# Leave unset if Atrium and BHCS share a single Supabase project.
BHCS_SUPABASE_URL=https://<project>.supabase.co
BHCS_SUPABASE_SERVICE_KEY=eyJ...

# ── Capture storage ──────────────────────────────────────────────────────────
# Where captured images are written. "local" for dev and offline kiosks,
# "drive" for production. Defaults to "drive" when unset, so a deploy that
# forgets this fails loudly instead of writing onto ephemeral serverless disk.
CAPTURE_STORAGE=drive
# Required when CAPTURE_STORAGE=local. Supports a leading ~.
CAPTURE_LOCAL_DIR=~/work/atrium/test-images

# ── Google Drive (used when CAPTURE_STORAGE=drive) ───────────────────────────
# Google Cloud Console → Credentials → OAuth client ID (Web application),
# with redirect URI http://localhost:4321/callback
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Both printed by: pnpm --filter @atrium/tools oauth
GOOGLE_REFRESH_TOKEN=...
GOOGLE_DRIVE_ROOT_FOLDER_ID=...

# ── Service ports (local dev, defaults shown) ────────────────────────────────
SKILL_GRAPH_PORT=3001
WORKSHEET_PORT=3002
EVALUATOR_PORT=3003
