# Copy to .env and fill in values. Never commit .env.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Gemini is the active provider for generation, worksheet evaluation, and OCR.
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash

# Claude is the longer-term option; ../chess-karma still uses it directly.
ANTHROPIC_API_KEY=sk-ant-...

# ── Illustration generation (tools/illustrate.ts) ────────────────────────────
# Provider is chosen automatically: FAL_KEY wins over HF_TOKEN if both are set.
# Override with: PROVIDER=hf or PROVIDER=fal
HF_TOKEN=hf_...
FAL_KEY=...

# ── Supabase ─────────────────────────────────────────────────────────────────
# Atrium's own project: owns captures + the flywheel tables.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── BHCS portal (student profiles) ───────────────────────────────────────────
# Source of truth for the student roster, read over the portal's cli-api — the
# same /v1 surface the `bhcs` CLI uses. Atrium holds an API key, not a database
# credential, so it can only see what that API exposes.
#
# Both values come from ~/.bhcs/config.json after `bhcs auth init`. Mint a
# separate key per deployment (`bhcs auth create-key --name atrium-prod`) so a
# leak can be revoked without taking down anyone else's.
BHCS_API_URL=https://<project>.supabase.co/functions/v1/cli-api
BHCS_API_KEY=bhcs_sk_...

# ── Admin surface ────────────────────────────────────────────────────────────
# Gates /api/captures and /api/capture-file, which expose every capture and
# every student name. Unset is fine locally; unset in production makes those
# routes 404 rather than publish the roster. Set it on any real deployment.
ADMIN_TOKEN=

# ── Capture storage ──────────────────────────────────────────────────────────
# Where captured images are written. "local" for dev and offline kiosks,
# "drive" for production. Defaults to "drive" when unset, so a deploy that
# forgets this fails loudly instead of writing onto ephemeral serverless disk.
CAPTURE_STORAGE=drive
# Required when CAPTURE_STORAGE=local. Supports a leading ~.
CAPTURE_LOCAL_DIR=~/work/atrium/test-images

# ── Google Drive (used when CAPTURE_STORAGE=drive) ───────────────────────────
# Google Cloud Console → Credentials → OAuth client ID (Web application),
# with redirect URI http://localhost:4321/callback
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Both printed by: pnpm --filter @atrium/tools oauth
GOOGLE_REFRESH_TOKEN=...
GOOGLE_DRIVE_ROOT_FOLDER_ID=...

# ── Service ports (local dev, defaults shown) ────────────────────────────────
SKILL_GRAPH_PORT=3001
WORKSHEET_PORT=3002
PRINT_AGENT_PORT=3003

# Where the kiosk finds the other services. Defaults suit `pnpm dev` on one
# machine; set them when anything moves off localhost.
SKILL_GRAPH_URL=http://127.0.0.1:3001
WORKSHEET_PRINT_URL=http://127.0.0.1:3002
PRINT_AGENT_URL=http://127.0.0.1:3003

# The CUPS queue Cards go to. `lpstat -p` lists what this machine can see.
# Unset means the print agent answers 503 and no Leaf is ever spent on a Card
# that cannot come out — which is the safe default, not a broken one.
ATRIUM_PRINTER=
