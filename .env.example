# Copy to .env and fill in values. Never commit .env.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Gemini is the active provider for generation, worksheet evaluation, and OCR.
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash

# Claude is the longer-term option; ../chess-karma still uses it directly.
ANTHROPIC_API_KEY=sk-ant-...

# ── Illustration generation (tools/illustrate.ts) ────────────────────────────
# Provider is chosen automatically: FAL_KEY wins over HF_TOKEN if both are set.
# Override with: PROVIDER=hf or PROVIDER=fal
HF_TOKEN=hf_...
FAL_KEY=...

# ── Supabase ─────────────────────────────────────────────────────────────────
# Atrium's own project: owns captures + the flywheel tables.
#
# A *secret* key (Settings → API Keys → "Publishable and secret API keys"), not
# a publishable one. Every table has RLS on with no policies, so a publishable
# key reads and writes nothing — the elevated key is what the server side needs.
# The legacy `service_role` JWT still works until the end of 2026, but a secret
# key can be revoked on its own without rotating the project's JWT secret, and
# it answers 401 in a browser, so leaking it into client code fails loudly
# rather than silently shipping full database access to every kiosk.
#
# Mint one per deployment so a leak forces a single rotation.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# ── BHCS portal (student profiles) ───────────────────────────────────────────
# Source of truth for the student roster, read over the portal's cli-api — the
# same /v1 surface the `bhcs` CLI uses. Atrium holds an API key, not a database
# credential, so it can only see what that API exposes.
#
# Both values come from ~/.bhcs/config.json after `bhcs auth init`. Mint a
# separate key per deployment (`bhcs auth create-key --name atrium-prod`) so a
# leak can be revoked without taking down anyone else's.
BHCS_API_URL=https://<project>.supabase.co/functions/v1/cli-api
BHCS_API_KEY=bhcs_sk_...

# ── Admin surface ────────────────────────────────────────────────────────────
# Gates /api/captures and /api/capture-file, which expose every capture and
# every student name. Unset is fine locally; unset in production makes those
# routes 404 rather than publish the roster. Set it on any real deployment.
ADMIN_TOKEN=

# ── Capture storage ──────────────────────────────────────────────────────────
# Where captured images are written. "local" for dev and offline kiosks,
# "drive" for production. Defaults to "drive" when unset, so a deploy that
# forgets this fails loudly instead of writing onto ephemeral serverless disk.
CAPTURE_STORAGE=drive
# Required when CAPTURE_STORAGE=local. Supports a leading ~.
CAPTURE_LOCAL_DIR=~/work/atrium/test-images

# ── Google Drive (used when CAPTURE_STORAGE=drive) ───────────────────────────
# Google Cloud Console → Credentials → OAuth client ID (Web application),
# with redirect URI http://localhost:4321/callback
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Both printed by: pnpm --filter @atrium/tools oauth
GOOGLE_REFRESH_TOKEN=...
GOOGLE_DRIVE_ROOT_FOLDER_ID=...

# ── Service ports (local dev, defaults shown) ────────────────────────────────
SKILL_GRAPH_PORT=3001
WORKSHEET_PORT=3002
PRINT_AGENT_PORT=3003

# Where the services find each other.
#
# Nothing in the deployment needs SKILL_GRAPH_URL. skill-graph and
# worksheet-print are both mounted inside the kiosk function
# (packages/kiosk/api/_entry.ts) and reach each other in-process — no network,
# nothing to configure, and no way to point a preview deploy at production
# data. Setting it overrides that, which is what keeps either service runnable
# on its own; leave it unset on Vercel.
SKILL_GRAPH_URL=http://127.0.0.1:3001

# Nothing else runs on the kiosk machine. worksheet-print is mounted inside the
# deployment alongside skill-graph, and there is no print agent at all: a Card
# is HTML now, and the browser that asked for it prints it.
#
# Start Chrome with --kiosk-printing on a station, so printing goes to the
# default printer with no dialog in front of a child.
#
# Both services can still be run on their own (`pnpm dev`, :3001 and :3002),
# which is what SKILL_GRAPH_URL above is for. Nothing needs it in production.

# Only the standalone print agent reads this, and nothing calls that agent any
# more — the browser prints. Kept because the package still runs on its own.
# `lpstat -p` lists what a machine can see.
ATRIUM_PRINTER=
